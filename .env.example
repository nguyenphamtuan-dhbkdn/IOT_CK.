# Chế độ phần cứng: real (chạy thiết bị thật trên Pi 4) hoặc mock (giả lập khi test dev trên Windows)
HARDWARE_MODE=real

# Cảm biến lực Load Cell (5kg) & ADC HX711 trên Raspberry Pi 4
HX711_DT_PIN=5
HX711_SCK_PIN=6
HX711_INVERT_SIGNAL=1
HX711_ZERO_BAND_G=0.5
HX711_MEDIAN_SAMPLES=9

# Ngưỡng hoạt động của State Machine
IDLE_WEIGHT_G=10.0
DETECT_WEIGHT_G=15.0
STABILITY_DELTA_G=2.0
STABILITY_HOLD_S=1.5

# Màn hình LCD 16x2 I2C (PCF8574)
LCD_I2C_ADDRESS=0x27
LCD_COLS=16
LCD_ROWS=2

# Camera USB
CAMERA_INDEX=0
CAMERA_DEVICE=/dev/video0

# AI Strategy: auto (tự phát hiện ncnn / onnx) | ncnn | yolov8 | mock
AI_STRATEGY=auto
AI_CONFIDENCE_THRESHOLD=0.50
AI_INPUT_SIZE=416
AI_NUM_THREADS=4

# VietQR thanh toán
VIETQR_BANK=VCB
VIETQR_ACCOUNT=0123456789
VIETQR_ACCOUNT_NAME=TRAM CAN AI

# Cấu hình Server
HOST=0.0.0.0
PORT=5000
DEBUG=0
SECRET_KEY=smart-ai-scale-production-key
